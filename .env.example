# Copy this file to `.env` and fill it in. `.env` is gitignored — keep it that way,
# because the session cookie below is a live credential for your Canvas account.

# Your school's Canvas domain. Origin only, no trailing slash, https required.
CANVAS_BASE_URL=https://yourschool.instructure.com

# The `_normandy_session` cookie value.
#
# How to get it:
#   1. Log into Canvas in Chrome.
#   2. Press F12, open the Application tab.
#   3. Storage > Cookies > your Canvas domain.
#   4. Copy the Value of `_normandy_session` and paste it below.
#
# It is httpOnly, so `document.cookie` in the console will NOT show it —
# the Application tab is the only way to read it.
#
# Lifetime: about 1 day. When Canvas tools start reporting an expired session,
# repeat the steps above and restart the server.
CANVAS_SESSION_COOKIE=

# Optional but recommended: the `pseudonym_credentials` cookie, copied the same way.
# It only exists if you ticked "Stay signed in" when logging in. Canvas uses it to
# mint a fresh session automatically, which stretches the refresh interval from
# ~1 day to ~2 weeks.
CANVAS_REMEMBER_COOKIE=

# Optional: your personal Canvas calendar feed, from Canvas > Calendar >
# "Calendar Feed" (bottom right). Copy the whole URL including the long code.
#
# This needs no cookie and no admin approval, so it keeps working when the session
# expires — get_upcoming_work and get_daily_briefing fall back to it and say so.
CANVAS_ICS_FEED_URL=

# Optional: a Canvas personal access token, if your school ever enables them
# (Account > Settings > New Access Token). Takes priority over the cookies and
# removes the expiry problem entirely.
CANVAS_ACCESS_TOKEN=
