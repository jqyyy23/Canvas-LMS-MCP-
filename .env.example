# Copy this file to `.env` and fill it in. `.env` is gitignored — keep it that way,
# because the session cookie below is a live credential for your Canvas account.

# Your school's Canvas domain. Origin only, https required (a trailing slash is fine).
CANVAS_BASE_URL=https://canvas.ubc.ca

# The session cookie value.
#
# How to get it:
#   1. Log into Canvas in Chrome.
#   2. Press F12, open the Application tab.
#   3. Storage > Cookies > your Canvas domain.
#   4. Find the large httpOnly cookie named `canvas_session` and copy its Value.
#
# It is httpOnly, so `document.cookie` in the console will NOT show it —
# the Application tab is the only way to read it.
#
# Lifetime: about 1 day. When Canvas tools report an expired session, run
# `npm run cookie` (it repeats the steps above from your clipboard and verifies the
# result). A running server adopts the new value on its next call; if the Canvas
# tools are missing or still failing, reload them — in Claude Code, /mcp > canvas >
# Reconnect — because the server process exited and cannot re-read this file.
CANVAS_SESSION_COOKIE=

# The name of the session cookie, if your Canvas differs from the default.
# Default: canvas_session (what canvas.ubc.ca uses).
# Upstream open-source Canvas ships `_normandy_session` instead, and other installs
# rename it again — whatever large httpOnly cookie your Canvas domain sets is the one.
# Getting this wrong looks exactly like an expired session, so check it first.
CANVAS_SESSION_COOKIE_NAME=canvas_session

# Optional: the `pseudonym_credentials` cookie, copied the same way. Canvas uses it
# to mint a fresh session automatically, stretching the refresh interval from ~1 day
# to ~2 weeks.
#
# It will NOT exist if your school uses single sign-on (UBC's CWL, for one): Canvas
# hands login to the campus identity provider, so its own "Stay signed in" box never
# appears. Leave this blank in that case and use `npm run cookie` to refresh daily.
CANVAS_REMEMBER_COOKIE=

# Optional: extra cookies to send verbatim, as `name=value; name2=value2`.
#
# Needed only if your Canvas sits behind a bot filter that turns requests away.
# canvas.ubc.ca is behind Cloudflare, but its /api/v1 endpoints were verified to
# pass through untouched, so you almost certainly do not need this. If that ever
# changes and you see 403s that are not rate limits, copy `cf_clearance` here, e.g.
#   CANVAS_EXTRA_COOKIES=cf_clearance=PASTE_VALUE_HERE
# Note that cf_clearance is tied to your IP and User-Agent, so it will need
# recopying more often than the session cookie.
CANVAS_EXTRA_COOKIES=

# Optional: override the User-Agent. Defaults to a current Chrome string, because
# the request carries a browser session cookie and bot filters reject unknown
# clients. Only change this if you have a reason to.
CANVAS_USER_AGENT=

# Optional: your personal Canvas calendar feed, from Canvas > Calendar >
# "Calendar Feed" (bottom right). Copy the whole URL including the long code.
#
# This needs no cookie and no admin approval, so it keeps working when the session
# expires — get_upcoming_work and get_daily_briefing fall back to it and say so.
CANVAS_ICS_FEED_URL=

# Optional: a Canvas personal access token, if your school ever enables them
# (Account > Settings > New Access Token). Takes priority over the cookies and
# removes the expiry problem entirely.
CANVAS_ACCESS_TOKEN=
